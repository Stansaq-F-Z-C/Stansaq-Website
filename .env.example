# Copy this file to .env and fill in real values before running "npm run seed" or "npm start".

# Port the Node process listens on.
# On a VPS: put nginx in front of this. On Render/Railway/etc: leave this out
# entirely — the platform sets PORT automatically and expects your app to
# read it, which server.js already does (process.env.PORT || 3000).
PORT=3000

# Long, random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# From your Supabase project: Settings > API.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — it must stay server-side only.
# Never send it to a browser, log it, or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only used once, by "npm run seed", to create the first admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Set to "production" on the VPS.
NODE_ENV=development

# On a VPS: leave "false" until nginx+certbot is actually serving HTTPS (see
# the Ops Runbook, Appendix B). On Render/Railway/etc: set to "true" from the
# very first deploy — the platform terminates HTTPS for you immediately,
# there's no waiting step.
TRUST_PROXY_HTTPS=false
